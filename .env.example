# --- Application ---
PORT=3000
NODE_ENV=development
# Origine autorisée par CORS (voir frontend/vite.config.ts : port 4200)
FRONTEND_URL=http://localhost:4200

# --- Base de données (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_NAME=cv_tech
# Port exposé sur la machine hôte par docker compose (le conteneur reste sur 3306).
# À changer si 3307 est déjà pris.
DB_PUBLISHED_PORT=3307
# Laisse TypeORM créer/mettre à jour le schéma au démarrage.
# Par défaut : actif hors production. Ne jamais activer sur une vraie base.
DB_SYNCHRONIZE=true

# --- Authentification ---
# Obligatoire : l'application refuse de démarrer sans secret.
SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=3600s

# --- Rate limiting (optionnel) ---
# Budget global ; /user et /user/login gardent une limite stricte de 5/min.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
