# --- Application ---
PORT=3000
NODE_ENV=development
# Origine autorisée par CORS (voir frontend/vite.config.ts : port 4200)
FRONTEND_URL=http://localhost:4200

# --- Base de données (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_NAME=cv_tech

# --- Authentification ---
# Obligatoire : l'application refuse de démarrer sans secret.
SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=3600s

# --- Rate limiting (optionnel) ---
# Budget global ; /user et /user/login gardent une limite stricte de 5/min.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
